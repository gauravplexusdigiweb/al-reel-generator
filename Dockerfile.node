# Single Node image for the API, the worker, and the web app (compose runs each
# with a different command). Build context is the repo root.
FROM node:22-slim

RUN corepack enable && \
    apt-get update && apt-get install -y --no-install-recommends openssl && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /repo

# The web app inlines NEXT_PUBLIC_* at build time.
ARG NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL}

COPY . .

RUN pnpm install --frozen-lockfile && \
    pnpm --filter @arg/shared build && \
    pnpm --filter @arg/api prisma:generate && \
    pnpm --filter @arg/api build && \
    pnpm --filter @arg/web build

# Default command (overridden per service in docker-compose).
CMD ["node", "apps/api/dist/main.js"]
