# ---- Database (PostgreSQL) ----
# Host 5432 is already in use on this machine, so the docker Postgres is mapped to 5433.
POSTGRES_PORT=5433
DATABASE_URL="postgresql://arg:arg@localhost:5433/arg?schema=public"

# ---- Redis / BullMQ ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- API ----
API_PORT=4000
API_BASE_URL=http://localhost:4000

# ---- Local storage ----
# Root directory for uploads, renditions, reels, thumbnails, frames.
DATA_DIR=./data

# ---- Upload limits / pipeline config ----
MAX_UPLOAD_MB=2048
ALLOWED_FORMATS=mp4,mov,mkv,avi
# Candidate reels to generate per video (PRD: 10-20)
CANDIDATE_MIN=10
CANDIDATE_MAX=20
# Reel duration buckets in seconds
DURATION_BUCKETS=15,30,45,60
# Frame sampling rate (fps) used for face/scene/thumbnail analysis
SAMPLE_FPS=2
# Keep intermediate files (sampled frames, audio.wav) after processing. Default false
# purges them to save disk once they're no longer needed.
RETAIN_INTERMEDIATES=false

# ---- ai-service (Python FastAPI) ----
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_PORT=8001
# faster-whisper model size: tiny|base|small|medium|large-v3
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ---- Ollama (LLM provider) ----
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ---- FFmpeg ----
# Leave empty to use bundled ffmpeg-static / ffprobe-static binaries.
# Set to an absolute path to override with a system install.
FFMPEG_PATH=
FFPROBE_PATH=

# ---- Web ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
